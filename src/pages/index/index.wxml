<view class="container">
  <scroll-view
    class="page-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    lower-threshold="240"
    bindscrolltolower="onScrollToLower"
  >
    <lp-hero-search
      eyebrow="AI PROMPTS"
      title="流金提示词"
      placeholder="搜索提示词..."
      bind:input="onSearchInput"
    />

    <lp-loading-card
      wx:if="{{loading}}"
      title="正在加载提示词"
      desc="首屏只拉取索引，详情按需加载"
    />

    <lp-empty-state
      wx:elif="{{error}}"
      icon="⚠️"
      title="加载失败"
      desc="{{error}}"
      action-text="重新加载"
      bind:action="onRetry"
    />

    <block wx:else>
      <view class="recommend-section" wx:if="{{trending.length && !activeKeyword}}">
        <view class="recommend-header">
          <text class="recommend-title">随机推荐</text>
        </view>
        <scroll-view class="recommend-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
          <view class="recommend-list">
            <lp-trending-card
              wx:for="{{trending}}"
              wx:key="id"
              item="{{item}}"
              bind:cardtap="onTrendingTap"
            />
          </view>
        </scroll-view>
      </view>

      <view class="results-bar">
        <text class="results-title">{{activeKeyword ? '搜索结果' : '全部提示词'}}</text>
        <text class="results-count">{{total}} 条</text>
        <view class="results-action" bindtap="openCategoryPage">分类浏览</view>
      </view>

      <view class="waterfall" wx:if="{{total}}">
        <view class="waterfall-column" wx:for="{{columns}}" wx:for-item="column" wx:key="key">
          <lp-prompt-card
            wx:for="{{column.items}}"
            wx:for-item="prompt"
            wx:key="id"
            item="{{prompt}}"
            bind:cardtap="onPromptTap"
            bind:tagtap="onTagTap"
          />
        </view>
      </view>

      <lp-empty-state
        wx:else
        icon="📝"
        title="暂无相关提示词"
        desc="试试其他关键词吧"
      />

      <view class="list-footer" wx:if="{{total}}">
        <text class="footer-text" wx:if="{{!hasMore}}">已经到底了</text>
      </view>
    </block>
  </scroll-view>
</view>
